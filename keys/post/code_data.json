{
 "code": [
  "# Moonlight Sonata \u2014 III. Presto agitato \u00b7 Beethoven",
  "# every key, light and frame below is computed from the score",
  "",
  "# --- keys ----------------------------------------------------------------",
  "blacks = {k: (xl, xr) for k, b, xc, (xl, xr) in layout if b}",
  "for k, is_black, xc, (xl, xr) in layout:",
  "    bm = bmesh.new()",
  "    if is_black:",
  "        y0, y1, z0, z1 = 0.052, KEY_BACK, KEY_BOT, KEY_TOP + 0.012",
  "        hw, tw = 0.00685, 0.0050",
  "        vs = [bm.verts.new(v) for v in [",
  "            (xc - hw, y0, z0), (xc + hw, y0, z0), (xc + hw, y1, z0), (xc - hw, y1, z0),",
  "            (xc - tw, y0 + 0.009, z1), (xc + tw, y0 + 0.009, z1), (xc + tw, y1, z1), (xc - tw, y1, z1)]]",
  "        for f in [(0, 3, 2, 1), (4, 5, 6, 7), (0, 1, 5, 4), (1, 2, 6, 5), (2, 3, 7, 6), (3, 0, 4, 7)]:",
  "            bm.faces.new([vs[i] for i in f])",
  "        ob = mesh_from_bmesh(f\"key_{k:02d}\", bm, M[\"ebony\"], coll)",
  "        add_bevel(ob, 0.0007, 2)",
  "    else:",
  "",
  "",
  "# --- anim.py ---",
  "def key_depth_frac(k, t, _nested=False):",
  "    \"\"\"0 up .. 1 bottomed (>1 felt compression, <0 overshoot above rest).\"\"\"",
  "    i = bisect.bisect_right(PRESS0[k], t) - 1",
  "    if i < 0:",
  "        return 0.0",
  "    n = KEYS[k][i]",
  "    start = key_depth_frac(k, n.press0 - 1e-6, True) if (i > 0 and not _nested) else 0.0",
  "    if t < n.t_full:",
  "        u = (t - n.press0) / (n.t_full - n.press0)",
  "        e = u * u * (3 - 2 * u) if u > 0 else 0.0",
  "        return start + (1 - start) * e",
  "    if t < n.vis_off:",
  "        r = t - n.t_full",
  "        bump = 0.075 * (n.v / 127) * (r / 0.006) * math.exp(1 - r / 0.006)   # felt bottom-out",
  "        return 1.0 + bump",
  "    r = t - n.vis_off",
  "    tau = max(0.012, n.rel * 0.38)",
  "    return math.exp(-r / tau) * math.cos(math.pi * r / (2.6 * tau))",
  "",
  "",
  "def key_depth_m(k, t):",
  "    i = bisect.bisect_right(PRESS0[k], t) - 1"
 ],
